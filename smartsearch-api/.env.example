# Application
ENVIRONMENT=development
PROJECT_NAME=Velt API
API_V1_STR=/api/v1
PUBLIC_API_BASE_URL=http://localhost:8000

# Security: generate unique values; never use these placeholders in production.
SECRET_KEY=replace-with-at-least-32-random-bytes
SHOPIFY_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=velt-api
JWT_AUDIENCE=velt-dashboard
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ENABLE_DOCS=true
TRUST_PROXY_HEADERS=false

# Data services
DATABASE_URL=postgresql://smartsearch:change-me@localhost:5433/smartsearch
REDIS_URL=redis://localhost:6379/0
CHROMA_DB_PATH=./chroma_db

# Embeddings
USE_HF_INFERENCE=false
HF_TOKEN=

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/shopify/callback
SHOPIFY_SCOPES=read_products,read_inventory
SHOPIFY_API_VERSION=2026-04

# Object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=smartsearch-uploads
ALLOW_LOCAL_STORAGE_FALLBACK=true
