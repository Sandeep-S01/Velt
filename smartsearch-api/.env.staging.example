# Application
ENVIRONMENT=production
PROJECT_NAME=Velt API
API_V1_STR=/api/v1
PUBLIC_API_BASE_URL=https://api-staging.example.com

# Security: replace every placeholder before deploying.
SECRET_KEY=replace-with-at-least-32-random-bytes
SHOPIFY_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=velt-api
JWT_AUDIENCE=velt-dashboard
BACKEND_CORS_ORIGINS=["https://dashboard-staging.example.com"]
ALLOWED_HOSTS=["api-staging.example.com"]
ENABLE_DOCS=false
TRUST_PROXY_HEADERS=true

# Data services
DATABASE_URL=postgresql://smartsearch:replace-password@staging-postgres.example.com:5432/smartsearch
REDIS_URL=rediss://:replace-password@staging-redis.example.com:6379/0
CHROMA_DB_PATH=/data/chroma

# Embeddings
USE_HF_INFERENCE=false
HF_TOKEN=

# Shopify
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_REDIRECT_URI=https://api-staging.example.com/api/v1/shopify/callback
SHOPIFY_SCOPES=read_products,read_inventory
SHOPIFY_API_VERSION=2026-04

# Object storage
MINIO_ENDPOINT=staging-object-storage.example.com
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key
MINIO_USE_SSL=true
MINIO_BUCKET_NAME=velt-staging-uploads
ALLOW_LOCAL_STORAGE_FALLBACK=false
